body{
    margin:0;
    padding:30px;
    background:#f0f4f8;
    font-family:Arial, Helvetica, sans-serif;
}

.certificado{
    width:1000px;
    min-height:700px;

    margin:auto;

    background:white;

    border:8px solid #c9a227;

    padding:50px;

    text-align:center;

    box-sizing:border-box;
}

.certificado h1{
    color:#c9a227;
    font-size:42px;
    margin-bottom:10px;
}

.certificado h2{
    color:#1e3a8a;
    font-size:30px;
}

#nombreAlumno{
    font-size:40px;
    margin:30px 0;
    color:#0f4c81;
}

#numeroCertificado{
    margin-top:30px;
    font-weight:bold;
}

button{
    display:block;
    margin:30px auto;
    padding:12px 25px;
    font-size:18px;
    cursor:pointer;
}